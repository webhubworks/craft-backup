<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- ddev's database; CI overrides these with real environment variables. -->
        <env name="CRAFT_DB_DRIVER" value="mysql"/>
        <env name="CRAFT_DB_SERVER" value="db"/>
        <env name="CRAFT_DB_PORT" value="3306"/>
        <env name="CRAFT_DB_DATABASE" value="db"/>
        <env name="CRAFT_DB_USER" value="db"/>
        <env name="CRAFT_DB_PASSWORD" value="db"/>
        <env name="CRAFT_SECURITY_KEY" value="craft-backup-tests-only"/>
    </php>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
