{
    "name": "webhubworks/craft-backup",
    "description": "A plugin to backup your Craft CMS app.",
    "type": "craft-plugin",
    "license": "mit",
    "authors": [
        {
            "name": "webhub GmbH",
            "homepage": "https://webhub.de"
        }
    ],
    "support": {
        "issues": "https://github.com/webhubworks/craft-backup/issues?state=open",
        "source": "https://github.com/webhubworks/craft-backup",
        "docs": "https://github.com/webhubworks/craft-backup",
        "rss": "https://github.com/webhubworks/craft-backup/releases.atom"
    },
    "require": {
        "php": ">=8.1",
        "craftcms/cms": "^4.4.0 || ^5.0.0",
        "fakerphp/faker": "^1.19",
        "league/flysystem-sftp-v3": "^3.36",
        "phpseclib/phpseclib": "^3.0.51"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "markhuot/craft-pest-core": "^3.2",
        "pestphp/pest": "^3.8",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "webhubworks\\backup\\": "src/"
        }
    },
    "extra": {
        "handle": "backup",
        "name": "Backup",
        "developer": "webhub GmbH",
        "documentationUrl": "https://github.com/webhubworks/craft-backup",
        "class": "webhubworks\\backup\\Plugin",
        "hasCpSettings": false
    },
    "scripts": {
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --ansi --fix",
        "phpstan": "phpstan --memory-limit=1G",
        "test": "pest --parallel",
        "check": [
            "@check-cs",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        },
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true,
            "pestphp/pest-plugin": true
        }
    }
}
